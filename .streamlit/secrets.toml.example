# Copy this file to .streamlit/secrets.toml for local development,
# or paste its contents into your Streamlit Community Cloud app's
# "Secrets" settings (Settings -> Secrets) for the deployed app.
#
# Never commit your real secrets.toml -- it's already in .gitignore.

ANTHROPIC_API_KEY = "sk-ant-...your-key-here..."

# Optional: require students to enter this code once per browser session
# before they can use AI Tutor Chat. Leave unset (or delete this line) to
# leave the chat open to anyone with the app link.
# CLASS_ACCESS_CODE = "choose-a-code"

# Optional: total Claude input+output tokens allowed across ALL students
# combined, per calendar day (UTC), before AI Tutor Chat pauses itself
# until the next day. Guards against a surprise bill on a shared API key.
# Default if unset: 200000.
# MAX_DAILY_TOKENS = 200000
